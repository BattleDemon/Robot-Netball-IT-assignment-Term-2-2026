CLASS CommunicationManager:

    ATTRIBUTES:
        state_manager       # reference to the local StateManager
        connection          # Bluetooth connection object
        send_interval       # how often to broadcast (e.g. every 200ms)

    METHODS:

        connect():
            # Establish Bluetooth connection to other robot
            # One robot is server, one is client (decided by config)

        encode(snapshot):
            # Takes the dictionary from state_manager.get_snapshot()
            # Converts to a simple string or byte format safe to send
            # e.g.  "x:45,y:120,ang:90,has_ball:1,req:RECEIVE"

        decode(raw_data):
            # Reverse of encode
            # Returns a clean dictionary

        send_loop():
            # Runs in its own thread
            # Every send_interval, calls state_manager.get_snapshot()
            # Encodes and sends it

        receive_loop():
            # Runs in its own thread
            # Waits for incoming data
            # Decodes it and updates the local StateManager:
            #     state_manager.update_other_position(...)
            #     state_manager.update_other_ball_position(...)
            #     state_manager.update_incoming_request(...)